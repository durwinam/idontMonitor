[Unit]
Description=idontMonitor sustained resource pressure watchdog
After=network-online.target
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/idontmonitor/current/scripts/idontmonitor-auto-reboot.py
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/idontmonitor
