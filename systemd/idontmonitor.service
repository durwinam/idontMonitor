[Unit]
Description=idontMonitor VPS Monitoring Web Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idontmonitor
Group=idontmonitor
EnvironmentFile=/etc/idontmonitor/environment
WorkingDirectory=/opt/idontmonitor/current
ExecStart=/opt/idontmonitor/venv/bin/uvicorn app.main:app --host ${IDM_BIND_HOST} --port ${IDM_APP_PORT} --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
# sudo must be able to perform its setuid/setgid transition for the fixed,
# root-owned allowlisted helper. Do not set an empty CapabilityBoundingSet:
# it strips CAP_SETUID/CAP_SETGID and causes sudoers_audit initialization to fail.
# The service itself still starts as idontmonitor with no ambient capabilities.
NoNewPrivileges=false
PrivateTmp=true
RuntimeDirectory=backpack-pck
RuntimeDirectoryMode=0755
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/idontmonitor /var/log/idontmonitor /etc/idontmonitor /etc/systemd/system /etc/backpack /run/backpack-pck
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
