[Unit]
Description=idontMonitor VPS Monitoring Web Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idontmonitor
Group=idontmonitor
EnvironmentFile=/etc/idontmonitor/environment
WorkingDirectory=/opt/idontmonitor/current
ExecStart=/opt/idontmonitor/venv/bin/uvicorn app.main:app --host ${IDM_BIND_HOST} --port ${IDM_APP_PORT} --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=false # Required for the narrowly scoped in-panel port helper
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/idontmonitor /var/log/idontmonitor /etc/idontmonitor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
